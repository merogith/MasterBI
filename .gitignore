# Virtualenv — recreate with requirements.txt, never commit
.venv/
venv/
env/

# Python bytecode / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Generated artifacts. Every file under these is reproducible output of a run
# (dashboards, PDFs, decks, workbooks, chart PNGs, fact CSVs). ~97 MB locally.
out/
runs/

# Static Pages build. CI regenerates it on every push (~22 MB of binaries);
# committing it would bloat history permanently.
site/

# Local-only editor / tooling state
.claude/settings.local.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets — nothing here today, keep it that way
.env
.env.*
*.pem
*.key

# Front-end build (1.1b). Vite output and its dependencies: `ui_dist/` is
# regenerated by `npm --prefix web run build` and bundled into the release by
# 1.3, so committing it would put a build artifact in history for the same
# reason `site/` is excluded above.
web/node_modules/
kpi_maker/ui_dist/
